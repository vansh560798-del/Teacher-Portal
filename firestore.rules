rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'yt.vgaming560798@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['userId', 'name', 'staffId', 'designation', 'department', 'nfcCardId', 'cardStatus']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.staffId is string && data.staffId.size() <= 32 &&
        data.designation is string && data.designation.size() <= 100 &&
        data.department is string && data.department.size() <= 100 &&
        data.nfcCardId is string && data.nfcCardId.size() <= 64 &&
        data.cardStatus in ['active', 'suspended', 'lost', 'deactivated'] &&
        (!('role' in data) || data.role in ['admin', 'teacher']);
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['teacherId', 'teacherName', 'staffId', 'timestamp', 'type', 'method', 'status']) &&
        data.teacherId is string && data.teacherId.size() <= 128 &&
        data.teacherName is string && data.teacherName.size() <= 120 &&
        data.staffId is string && data.staffId.size() <= 32 &&
        data.timestamp is string && data.timestamp.size() <= 64 &&
        data.type in ['check-in', 'check-out'] &&
        data.method in ['nfc', 'biometric', 'manual', 'qr'] &&
        data.status in ['verified', 'flagged'];
    }

    function isValidClass(data) {
      return data.keys().hasAll(['teacherId', 'className', 'grade', 'room', 'subject', 'schedule', 'studentCount']) &&
        data.teacherId is string && data.teacherId.size() <= 128 &&
        data.className is string && data.className.size() <= 100 &&
        data.grade is string && data.grade.size() <= 50 &&
        data.room is string && data.room.size() <= 50 &&
        data.subject is string && data.subject.size() <= 100 &&
        data.studentCount is number;
    }

    function isValidAssignment(data) {
      return data.keys().hasAll(['teacherId', 'className', 'title', 'dueDate', 'maxScore', 'status']) &&
        data.teacherId is string && data.teacherId.size() <= 128 &&
        data.className is string && data.className.size() <= 100 &&
        data.title is string && data.title.size() <= 200 &&
        data.dueDate is string && data.dueDate.size() <= 64 &&
        data.maxScore is number &&
        data.status in ['active', 'graded', 'draft'];
    }

    function isValidGrade(data) {
      return data.keys().hasAll(['teacherId', 'studentId', 'studentName', 'score', 'maxScore', 'letterGrade']) &&
        data.teacherId is string && data.teacherId.size() <= 128 &&
        data.studentId is string && data.studentId.size() <= 64 &&
        data.studentName is string && data.studentName.size() <= 100 &&
        data.score is number &&
        data.maxScore is number &&
        data.letterGrade is string && data.letterGrade.size() <= 10;
    }

    function isValidResource(data) {
      return data.keys().hasAll(['teacherId', 'title', 'type', 'subject']) &&
        data.teacherId is string && data.teacherId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.type in ['note', 'pdf', 'plan', 'presentation'] &&
        data.subject is string && data.subject.size() <= 100;
    }

    function isValidLeave(data) {
      return data.keys().hasAll(['teacherId', 'teacherName', 'leaveType', 'startDate', 'endDate', 'reason', 'status']) &&
        data.teacherId is string && data.teacherId.size() <= 128 &&
        data.teacherName is string && data.teacherName.size() <= 120 &&
        data.leaveType in ['sick', 'casual', 'medical', 'conference', 'maternity'] &&
        data.startDate is string && data.startDate.size() <= 64 &&
        data.endDate is string && data.endDate.size() <= 64 &&
        data.reason is string && data.reason.size() <= 500 &&
        data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidSecurityAlert(data) {
      return data.keys().hasAll(['cardId', 'type', 'severity', 'details', 'resolved', 'timestamp']) &&
        data.cardId is string && data.cardId.size() <= 64 &&
        data.type in ['lost_card', 'unauthorized_scan', 'tamper_detected', 'biometric_mismatch'] &&
        data.severity in ['low', 'medium', 'high', 'critical'] &&
        data.details is string && data.details.size() <= 500 &&
        data.resolved is bool;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Teacher Profiles
    match /teachers/{teacherId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(teacherId) && isValidTeacher(incoming()) && (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(teacherId) && isValidTeacher(incoming()) && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if isAdmin();
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && (existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(incoming()) && (incoming().teacherId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Classes & Timetable
    match /classes/{classId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(classId) && isValidClass(incoming()) && (incoming().teacherId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(classId) && isValidClass(incoming()) && (existing().teacherId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(classId) && (existing().teacherId == request.auth.uid || isAdmin());
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(assignmentId) && isValidAssignment(incoming()) && (incoming().teacherId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(assignmentId) && isValidAssignment(incoming()) && (existing().teacherId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(assignmentId) && (existing().teacherId == request.auth.uid || isAdmin());
    }

    // Grades
    match /grades/{gradeId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(gradeId) && isValidGrade(incoming()) && (incoming().teacherId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(gradeId) && isValidGrade(incoming()) && (existing().teacherId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(gradeId) && (existing().teacherId == request.auth.uid || isAdmin());
    }

    // Teaching Resources Library
    match /resources/{resourceId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(resourceId) && isValidResource(incoming()) && (incoming().teacherId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(resourceId) && isValidResource(incoming()) && (existing().teacherId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(resourceId) && (existing().teacherId == request.auth.uid || isAdmin());
    }

    // Leave Management
    match /leaves/{leaveId} {
      allow get: if isSignedIn() && (existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(leaveId) && isValidLeave(incoming()) && (incoming().teacherId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(leaveId) && isValidLeave(incoming()) && (
        isAdmin() ||
        (existing().teacherId == request.auth.uid && incoming().teacherId == existing().teacherId && incoming().status == existing().status)
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().teacherId == request.auth.uid && existing().status == 'pending');
    }

    // Security Alerts (Lost Card Protection, Anomalies)
    match /security_alerts/{alertId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(alertId) && isValidSecurityAlert(incoming());
      allow update: if isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['resolved']));
      allow delete: if isAdmin();
    }
  }
}
